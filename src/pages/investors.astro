---
import BaseLayout from '../layouts/BaseLayout.astro';
import InvestorPage from '../components/InvestorPage.astro';
import { investors } from '../i18n/investors';

const t = investors.en;
---
<BaseLayout
  lang="en"
  route="investors"
  title={t.title}
  description={t.description}
  faqHref="#faq"
  stickyCta={{ href: '#register', label: t.sticky }}
>
  <InvestorPage lang="en" />
</BaseLayout>
