---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Thanks from '../../components/Thanks.astro';
import { sellerForm } from '../../i18n/sellerForm';

const t = sellerForm.en.thanks;
---
<BaseLayout lang="en" route="sellThanks" title={t.title} description={t.description} faqHref="/sell-your-house#faq" noindex>
  <Thanks lang="en" copy={t} />
</BaseLayout>
