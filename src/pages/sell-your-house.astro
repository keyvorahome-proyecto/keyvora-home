---
import SellerForm from '../components/SellerForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  lang="en"
  route="sell"
  title={'Sell Your House in Cleveland, Ohio, On Your Timeline | Keyvora Home'}
  description={'Sell your Cleveland, Ohio house as-is, on your timeline: no repairs, no showings, and no fees or commissions charged by Keyvora. We work with cash buyers. No obligation.'}
  faqHref="#faq"
  stickyCta={{ href: '#offer', label: 'Start property review' }}
>
  <section class="hero">
    <svg class="hero-roofline" viewBox="0 0 340 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M20 140 L170 15 L320 140" stroke="#A38D78" stroke-width="2"/>
    </svg>
    <div class="container hero-inner">
      <div class="eyebrow">Sell Your House</div>
      <h1>Thinking about selling your Cleveland property?</h1>
      <p class="lead">Whatever the condition or situation, Keyvora Home makes it simple to sell directly, on your timeline, without the usual hassle of listing a home. We work with cash buyers, and Keyvora charges you no fees or commissions.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#offer">Start my property review</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="value-strip">
        <div class="value-item">
          <div class="icon">🔧</div>
          <h3>No repairs</h3>
          <p>Sell your house exactly as it is, in any condition.</p>
        </div>
        <div class="value-item">
          <div class="icon">⏱️</div>
          <h3>On your timeline</h3>
          <p>No listing process — you choose the pace that works for you.</p>
        </div>
        <div class="value-item">
          <div class="icon">🚪</div>
          <h3>No showings</h3>
          <p>No strangers walking through your home, no open houses.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">How it works</div>
        <h2>A straightforward process</h2>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Tell us about your property</h3>
          <p>Share a few basic details through the short form below.</p>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>We follow up</h3>
          <p>We reach out to learn more and discuss your situation directly.</p>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>You decide</h3>
          <p>If an offer makes sense for you, you choose whether and when to move forward.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="offer">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Get started</div>
        <h2>Tell us about your property</h2>
      </div>
      <SellerForm lang="en" />
      <p class="alt-contact">Prefer to talk it through? <a href="tel:+12166772783">Call</a> or <a href="sms:+12166772783">text</a> us at (216) 677-2783.</p>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">FAQ</div>
        <h2>Common questions</h2>
      </div>
      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-1">
            Does my house need to be in good condition?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-answer-1" role="region">
            <p>No. We consider properties in any condition, including those needing significant repairs.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-2">
            How long does the process take?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-answer-2" role="region">
            <p>Timelines depend on each property and situation. Once we connect, we'll walk you through what to expect for your specific case.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-3">
            Am I obligated to accept an offer?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-answer-3" role="region">
            <p>Not at all. Submitting your information starts a conversation — you're never obligated to accept any offer we present.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-4">
            What areas do you serve?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-answer-4" role="region">
            <p>We work with homeowners in Cleveland and throughout Cuyahoga County, Ohio.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-5">
            Do you charge any fees?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-answer-5" role="region">
            <p>No. Keyvora Home doesn't charge you any fees or commissions. Standard closing costs, such as title and escrow fees, are handled through the title company and will be explained before you sign anything.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
