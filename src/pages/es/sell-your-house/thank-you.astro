---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Thanks from '../../../components/Thanks.astro';
import { sellerForm } from '../../../i18n/sellerForm';

const t = sellerForm.es.thanks;
---
<BaseLayout lang="es" route="sellThanks" title={t.title} description={t.description} faqHref="/es/sell-your-house#faq" noindex>
