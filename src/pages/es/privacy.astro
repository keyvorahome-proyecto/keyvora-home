import PrivacyPage from '../../components/PrivacyPage.astro';
import { privacy } from '../../i18n/privacy';

const t = privacy.es;
import { breadcrumbSchema } from '../../lib/schema';
---
<BaseLayout jsonLd={[breadcrumbSchema('es', 'privacy')]} lang="es" route="privacy" title={t.title} description={t.description} faqHref="/es/sell-your-house#faq">
  <PrivacyPage lang="es" />
</BaseLayout>
