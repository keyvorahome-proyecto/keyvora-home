---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InvestorPage from '../../components/InvestorPage.astro';
import { investors } from '../../i18n/investors';

const t = investors.es;
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
---
<BaseLayout jsonLd={[faqSchema(t.faq.items), breadcrumbSchema('es', 'investors')]}
  lang="es"
  route="investors"
  title={t.title}
  description={t.description}
  faqHref="#faq"
  stickyCta={{ href: '#register', label: t.sticky }}
>
  <InvestorPage lang="es" />
</BaseLayout>
