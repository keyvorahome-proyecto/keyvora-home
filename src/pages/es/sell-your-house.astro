---
import SellerForm from '../../components/SellerForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { faqSchema, breadcrumbSchema } from '../../lib/schema';
const faq = [
  {
    "q": "¿Mi casa tiene que estar en buen estado?",
    "a": "No. Consideramos propiedades en cualquier condición, incluidas aquellas que necesitan reparaciones importantes."
  },
  {
    "q": "¿Cuánto tiempo lleva el proceso?",
    "a": "Los tiempos dependen de cada propiedad y situación. Una vez que nos contactemos, te vamos a explicar qué esperar en tu caso particular."
  },
  {
    "q": "¿Estoy obligado a aceptar una oferta?",
    "a": "Para nada. Enviar tus datos solo da inicio a una conversación — nunca estás obligado a aceptar ninguna oferta que te presentemos."
  },
  {
    "q": "¿En qué zonas trabajan?",
    "a": "Trabajamos con propietarios en Cleveland y en todo el condado de Cuyahoga, Ohio."
  },
  {
    "q": "¿Cobran algún fee o comisión?",
    "a": "No. Keyvora Home no te cobra ningún fee ni comisión. Los costos de cierre habituales, como los de título y escrow, se manejan a través de la title company y te los explicamos antes de que firmes nada."
  }
];
---
<BaseLayout
  lang="es"
  route="sell"
  title={'Vendé tu Casa en Cleveland, Ohio, en tus Tiempos | Keyvora Home'}
  description={'Vendé tu casa en Cleveland, Ohio tal como está y en tus tiempos: sin reparaciones, sin visitas y sin fees ni comisiones de Keyvora. Sin compromiso.'}
  faqHref="#faq"
  jsonLd={[faqSchema(faq), breadcrumbSchema('es', 'sell')]}
  stickyCta={{ href: '#offer', label: 'Revisar mi propiedad' }}
>
  <section class="hero">
    <svg class="hero-roofline" viewBox="0 0 340 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M20 140 L170 15 L320 140" stroke="#A38D78" stroke-width="2"/>
    </svg>
    <div class="container hero-inner">
      <div class="eyebrow">Vender mi Casa</div>
      <h1>¿Estás pensando en vender tu propiedad en Cleveland?</h1>
      <p class="lead">Sea cual sea el estado o la situación, Keyvora Home hace que vender de forma directa sea simple, en tus tiempos, sin las complicaciones habituales de publicar una casa en el mercado. Trabajamos con compradores que pagan en efectivo, y Keyvora no te cobra fees ni comisiones.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#offer">Quiero que revisen mi propiedad</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="sr-only">Por qué vender con Keyvora</h2>
      <div class="value-strip">
        <div class="value-item">
          <div class="icon">🔧</div>
          <h3>Sin reparaciones</h3>
          <p>Vendé tu casa tal como está, en cualquier condición.</p>
        </div>
        <div class="value-item">
          <div class="icon">⏱️</div>
          <h3>En tus tiempos</h3>
          <p>Sin publicar la casa — vos elegís el ritmo que te conviene.</p>
        </div>
        <div class="value-item">
          <div class="icon">🚪</div>
          <h3>Sin visitas</h3>
          <p>Sin desconocidos recorriendo tu casa, sin open houses.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Cómo funciona</div>
        <h2>Un proceso simple y directo</h2>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Contanos sobre tu propiedad</h3>
          <p>Compartí algunos datos básicos en el formulario breve de abajo.</p>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Te contactamos</h3>
          <p>Nos comunicamos con vos para conocer más y hablar sobre tu situación directamente.</p>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>Vos decidís</h3>
          <p>Si una oferta tiene sentido para vos, elegís si y cuándo avanzar.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="offer">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Empezá ahora</div>
        <h2>Contanos sobre tu propiedad</h2>
      </div>
      <SellerForm lang="es" />
      <p class="alt-contact">¿Preferís hablarlo? <a href="tel:+12166772783">Llamanos</a> o <a href="sms:+12166772783">escribinos</a> al (216) 677-2783.</p>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Preguntas Frecuentes</div>
        <h2>Dudas comunes</h2>
      </div>
      <div class="faq-list">
        {faq.map((item, i) => (
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false" aria-controls={`faq-answer-${i + 1}`}>
              {item.q}
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer" id={`faq-answer-${i + 1}`} role="region">
              <p>{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
