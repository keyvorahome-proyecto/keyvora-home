---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  lang="en"
  route="home"
  title={'Keyvora Home | Off-Market Real Estate Opportunities in Cleveland, Ohio'}
  description={'Keyvora Home connects investors with off-market real estate opportunities in Cleveland, Ohio, and helps homeowners sell as-is, on their timeline, with no fees or commissions charged by Keyvora.'}
  faqHref="/investors#faq"
>
  <section class="hero">
    <svg class="hero-roofline" viewBox="0 0 340 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M20 140 L170 15 L320 140" stroke="#A38D78" stroke-width="2"/>
    </svg>
    <div class="container hero-inner">
      <div class="eyebrow">Cleveland, Ohio</div>
      <h1>Real estate solutions, built on trust</h1>
      <p class="lead">Keyvora Home connects real estate investors with off-market opportunities in Cleveland, and helps local homeowners sell directly, on their timeline — with no fees or commissions charged by Keyvora, and no pressure.</p>
    </div>
  </section>

  <section class="container">
    <div class="path-cards">
      <div class="path-card">
        <div class="icon">🏗️</div>
        <h3>I'm an investor</h3>
        <p>Get access to off-market properties in Cleveland, matched to your investment strategy.</p>
        <a class="btn btn-primary" href="/investors">Join the buyers list</a>
      </div>
      <div class="path-card">
        <div class="icon">🏠</div>
        <h3>I want to sell my house</h3>
        <p>Sell your Cleveland property as-is, on your timeline, without repairs, showings, or agent commissions.</p>
        <a class="btn btn-primary" href="/sell-your-house">Start my property review</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Why Cleveland</div>
        <h2>A market we chose deliberately</h2>
        <p>We focus specifically on Cleveland, Ohio, based on direct analysis of the local market — its price points, neighborhood trends, and the balance between property values and rental or resale potential. Rather than operating broadly across many markets, Keyvora Home concentrates on knowing this one well.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">How it works</div>
        <h2>A simple, direct process</h2>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Connect</h3>
          <p>Tell us what you're looking for — as an investor or as a homeowner — through a short form.</p>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Review</h3>
          <p>We follow up directly to understand your goals and share relevant details or next steps.</p>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>Move forward</h3>
          <p>Whether it's reviewing an opportunity or an offer on your property, you decide when to proceed.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
