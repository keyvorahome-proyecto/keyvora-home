---
// Thank-you page body shared by the seller (spec 41–42) and investor
// (spec 54) funnels.
import { routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  copy: {
    eyebrow: string;
    h1: string;
    lead: string;
    steps: readonly string[];
    call: string;
    home: string;
    how: string;
  };
  howHref?: string;
}

const { lang, copy: t, howHref = routes.home[lang] + '#how-it-works' } = Astro.props;
---
<section class="hero thanks-hero">
  <div class="container hero-inner thanks-inner">
    <div class="thanks-check" aria-hidden="true">
      <svg viewBox="0 0 48 48" width="48" height="48"><circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="2"/><path d="M14 25 L21 32 L34 17" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="eyebrow">{t.eyebrow}</div>
    <h1>{t.h1}</h1>
    <p class="lead">{t.lead}</p>
    <ol class="thanks-steps">
      {t.steps.map((step, i) => (
        <li><span class="step-number" aria-hidden="true">{i + 1}</span><span>{step}</span></li>
      ))}
    </ol>
    <div class="hero-actions">
      <a class="btn btn-primary" href="tel:+12166772783">{t.call}</a>
      <a class="btn btn-secondary" href={routes.home[lang]}>{t.home}</a>
    </div>
    <p class="thanks-more"><a href={howHref}>{t.how}</a></p>
  </div>
</section>
