---
// Responsive photo: WebP at a small and a large width with a JPEG fallback.
// Files live in public/images as <name>-<small>.webp, <name>-<large>.webp, <name>-<large>.jpg.
interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  sizes: string;
  eager?: boolean;
  class?: string;
  small?: number;
  large?: number;
}

const { name, alt, width, height, sizes, eager = false, class: className, small = 800, large = 1280 } = Astro.props;
const base = `/images/${name}`;
---
<picture class={className}>
  <source type="image/webp" srcset={`${base}-${small}.webp ${small}w, ${base}-${large}.webp ${large}w`} sizes={sizes} />
  <img
    src={`${base}-${large}.jpg`}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</picture>
